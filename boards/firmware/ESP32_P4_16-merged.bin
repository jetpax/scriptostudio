### Calendar View Usage Example

```python
# Map weather conditions to Cozette glyphs
WEATHER_ICONS = {
    'clear':   '\u263c',   # â˜¼
    'cloudy':  '\u2601',   # â˜
    'rain':    '\u2602',   # â˜‚
    'snow':    '\u2744',   # â„
    'storm':   '\u26a1',   # âš¡
    'fog':     '\u2601',   # â˜ (reuse cloud)
}

# Temperature icon by range
def temp_icon(celsius):
    if celsius >= 35: return '\uf2c7'   # full
    if celsius >= 25: return '\uf2c8'   # Â¾
    if celsius >= 15: return '\uf2c9'   # Â½
    if celsius >= 5:  return '\uf2ca'   # Â¼
    return '\uf2cb'                      # empty
```

