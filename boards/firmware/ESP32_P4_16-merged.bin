      "bl_pwm": 48
    }
  },

  "devices": {
    "display": {
      "type": "ST7789",
      "driver": "st7789",
      "bus": "spi.lcd",
      "width": 172,
      "height": 320,
      "offset_x": 34,
      "offset_y": 0,
      "color_bits": 16,
      "backlight": {
        "pin": 48,
        "active_high": true,
        "pwm_capable": true,
        "circuit": "N-channel MOSFET (SI2302CDS) sinks LEDK when gate driven high"
      },
      "description": "1.47\" 172x320 IPS LCD (ST7789V2)"
    },

    "status_led": {
      "type": "neopixel",
      "pin": 38,
      "pixel_order": "GRB",
      "description": "Onboard RGB NeoPixel LED on GPIO38"
    },

    "sdcard": {
      "mode": "SDMMC",
      "bus": "sdmmc.sdcard",
      "bus_width": 4,
      "description": "TF/microSD card (SDMMC 4-bit mode)"
    }
  },

  "memory": {
    "flash_size": "16MB",
    "psram_size": "8MB",
    "psram_mode": "octal"
  }
}
